# Njumeni environment template — placeholders only.
# Copy to a local ignored file only after the environment/toolchain is established.
# Never place real credentials in this file or commit a populated environment file.

APP_ENV=local
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Public client configuration only. These values are not authorisation controls.
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only credentials. Do not use production values locally or in CI.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional local infrastructure; exact providers are not yet selected.
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=njumeni-local
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-local-secret-key

# Provider credentials are disabled by default. Use mocks unless explicitly approved.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER_DEFAULT=mock
